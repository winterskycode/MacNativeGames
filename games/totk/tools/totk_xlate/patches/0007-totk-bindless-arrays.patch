diff --git a/src/Ryujinx.Graphics.Shader/Translation/Optimizations/TotkBindless.cs b/src/Ryujinx.Graphics.Shader/Translation/Optimizations/TotkBindless.cs
new file mode 100644
index 0000000..d22869f
--- /dev/null
+++ b/src/Ryujinx.Graphics.Shader/Translation/Optimizations/TotkBindless.cs
@@ -0,0 +1,110 @@
+using Ryujinx.Graphics.Shader.IntermediateRepresentation;
+using System.Collections.Generic;
+
+using static Ryujinx.Graphics.Shader.IntermediateRepresentation.OperandHelper;
+
+namespace Ryujinx.Graphics.Shader.Translation.Optimizations
+{
+    /// <summary>
+    /// TOTK: sampled textures bound through the texture constant buffer are read from global descriptor arrays
+    /// instead of a binding of their own. For the shader's k-th such texture the host writes, at word k of a per-draw
+    /// slot block (constant buffer QueryTotkSlotBuffer), the array slot of the view it resolved for the draw in the low
+    /// 20 bits and the sampler's slot above them; the shader indexes the arrays with those. Buffer and multisample textures,
+    /// images and handles from other constant buffers keep their own bindings.
+    /// </summary>
+    static class TotkBindless
+    {
+        private const int NvnTextureBufferIndex = 2;
+
+        /// <summary>
+        /// Converts one function's texture operations; true when the host asked for it. The single textures still in use
+        /// are noted in the resource manager, which drops the others once every function is done (PruneTotkTextures).
+        /// </summary>
+        public static bool RunPass(BasicBlock[] blocks, ResourceManager resourceManager, IGpuAccessor gpuAccessor)
+        {
+            if (!gpuAccessor.QueryTotkBindless())
+            {
+                return false;
+            }
+
+            int slotBuffer = gpuAccessor.QueryTotkSlotBuffer();
+            HashSet<(int, int)> used = resourceManager.TotkUsedTextures;
+
+            foreach (BasicBlock block in blocks)
+            {
+                for (LinkedListNode<INode> node = block.Operations.First; node != null; node = node.Next)
+                {
+                    if (node.Value is TextureOperation texOp && !TryConvert(block, node, texOp, resourceManager, gpuAccessor, slotBuffer))
+                    {
+                        used.Add((texOp.Set, texOp.Binding));
+                    }
+                }
+            }
+
+            return true;
+        }
+
+        private static bool TryConvert(
+            BasicBlock block,
+            LinkedListNode<INode> node,
+            TextureOperation texOp,
+            ResourceManager resourceManager,
+            IGpuAccessor gpuAccessor,
+            int slotBuffer)
+        {
+            SamplerType type = texOp.Type;
+
+            if ((texOp.Flags & TextureFlags.Bindless) != 0 ||
+                texOp.Inst.IsImage() ||
+                texOp.SamplerSet >= 0 ||
+                type == SamplerType.None ||
+                (type & SamplerType.Mask) == SamplerType.TextureBuffer ||
+                (type & SamplerType.Multisample) != 0 ||
+                !resourceManager.TryGetTotkBoundTexture(texOp.Set, texOp.Binding, out int cbufSlot, out int handle, out _) ||
+                (cbufSlot >= 0 && cbufSlot != NvnTextureBufferIndex))
+            {
+                return false;
+            }
+
+            int index = gpuAccessor.RegisterTotkBindless(handle, cbufSlot, type);
+
+            Operand slots = Local();
+            Operand textureIndex = Local();
+
+            block.Operations.AddBefore(node, new Operation(Instruction.Copy, slots, Cbuf(slotBuffer, index)));
+            block.Operations.AddBefore(node, new Operation(Instruction.BitwiseAnd, textureIndex, slots, Const(0xfffff)));
+
+            texOp.InsertSource(0, textureIndex);
+
+            // Array length 0: an unsized (runtime) array, as long as the host's array.
+            SetBindingPair textureSetAndBinding = resourceManager.GetTextureOrImageBinding(
+                texOp.Inst,
+                type,
+                texOp.Format,
+                texOp.Flags,
+                0,
+                TextureHandle.PackOffsets(0, 0, TextureHandleType.Direct),
+                0,
+                true);
+
+            Operand samplerIndex = Local();
+
+            block.Operations.AddBefore(node, new Operation(Instruction.ShiftRightU32, samplerIndex, slots, Const(20)));
+
+            texOp.InsertSource(1, samplerIndex);
+
+            SetBindingPair samplerSetAndBinding = resourceManager.GetTextureOrImageBinding(
+                texOp.Inst,
+                SamplerType.None,
+                texOp.Format,
+                TextureFlags.None,
+                0,
+                TextureHandle.PackOffsets(0, 0, TextureHandleType.Direct),
+                0);
+
+            texOp.TurnIntoArray(textureSetAndBinding, samplerSetAndBinding);
+
+            return true;
+        }
+    }
+}
