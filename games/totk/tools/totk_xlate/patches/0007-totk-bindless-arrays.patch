+        /// <summary>
+        /// TOTK: the constant buffer slot and handle of the bound (single) texture at a set and binding.
+        /// </summary>
+        public bool TryGetTotkBoundTexture(int set, int binding, out int cbufSlot, out int handle, out bool separate)
+        {
+            foreach ((TextureInfo info, TextureMeta meta) in _usedTextures)
+            {
+                if (meta.Set == set && meta.Binding == binding && info.ArrayLength == 1)
+                {
+                    cbufSlot = info.CbufSlot;
+                    handle = info.Handle;
+                    separate = info.Separate;
+                    return true;
+                }
+            }
+
+            cbufSlot = handle = 0;
+            separate = false;
+            return false;
+        }
+
+        /// <summary>
+        /// TOTK: forget the single textures no operation of any function uses any more (TotkBindless turned them into global
+        /// array accesses and noted the rest in TotkUsedTextures).
+        /// </summary>
+        public readonly HashSet<(int, int)> TotkUsedTextures = new();
+
+        public void PruneTotkTextures()
+        {
+            HashSet<(int, int)> used = TotkUsedTextures;
+
+            List<TextureInfo> unused = new();
+
+            foreach ((TextureInfo info, TextureMeta meta) in _usedTextures)
+            {
+                if (info.ArrayLength == 1 && !used.Contains((meta.Set, meta.Binding)))
+                {
+                    unused.Add(info);
+                }
+            }
+
+            foreach (TextureInfo info in unused)
+            {
+                TextureMeta meta = _usedTextures[info];
+
+                _usedTextures.Remove(info);
+                Properties.RemoveTexture(new SetBindingPair(meta.Set, meta.Binding));
+            }
+        }
